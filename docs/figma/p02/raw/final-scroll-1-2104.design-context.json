      "text": "const imgDoneRound = \"https://www.figma.com/api/mcp/asset/d6668f4e-caf8-4c70-8718-ccf4f55ac7ab.svg\";\nconst imgImage634450437 = \"https://www.figma.com/api/mcp/asset/3e8c2947-bacf-401d-8466-ca624d08d73f.png\";\nconst imgGroup2087328481 = \"https://www.figma.com/api/mcp/asset/3ec34012-056d-479b-aa13-23122e389aa1.svg\";\nconst imgRectangle240650891 = \"https://www.figma.com/api/mcp/asset/3e765d22-86b5-43f1-9d48-847cf1580fef.svg\";\nconst imgGroup2087328480 = \"https://www.figma.com/api/mcp/asset/b3056140-dc41-47b3-ad01-049a5c7131cf.svg\";\nconst imgVector4556 = \"https://www.figma.com/api/mcp/asset/832b97a8-a1e7-431e-b9fd-c95d96af6a29.svg\";\n\nfunction DoneRound({ className }: { className?: string }) {\n  return (\n    <div className={className || \"relative size-[24px]\"} data-node-id=\"1:315\" data-name=\"Done_round\">\n      <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgDoneRound} />\n    </div>\n  );\n}\n\nexport default function FinalScrollState() {\n  return (\n    <div className=\"bg-white relative size-full\" data-node-id=\"1:2104\" data-name=\"Final Scroll State\">\n      <div className=\"absolute bg-[#f5f5f5] h-[480px] left-[560px] overflow-clip top-[80px] w-[800px]\" data-node-id=\"1:2105\">\n        <div className=\"absolute inset-[16.67%_-7.58%_4.17%_58.5%]\" data-node-id=\"1:2106\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgGroup2087328481} />\n        </div>\n        <p className=\"[word-break:break-word] absolute font-['RussianRail_G_Pro:Regular'] leading-[normal] left-[28px] not-italic text-[#4b4b4b] text-[12px] top-[28px] tracking-[0.6px] uppercase whitespace-nowrap\" data-node-id=\"1:2348\">\n          / гарантированный подарок\n        </p>\n        <div className=\"[word-break:break-word] absolute content-stretch flex flex-col gap-[8px] items-start left-[28px] not-italic text-[#4353b0] top-[134px] w-[336px]\" data-node-id=\"1:2349\">\n          <p className=\"font-['RussianRail_G_Pro:Medium'] leading-[0] relative shrink-0 text-[48px] w-full\" data-node-id=\"1:2350\">\n            <span className=\"leading-[52px] text-[#4a66ca]\">СКИДКА 9% НА</span>\n            <span className=\"leading-[52px]\">{` ОТЕЛИ И ЭКСКУРСИИ`}</span>\n          </p>\n          <p className=\"font-['FSRAILWAY_Book:Regular'] leading-[24px] relative shrink-0 text-[16px] w-full\" data-node-id=\"1:2351\">\n            Промокод «РЖД плюс» получит каждый участник после авторизации через VK ID\n          </p>\n        </div>\n        <div className=\"absolute left-[744px] size-[56px] top-[424px]\" data-node-id=\"1:2352\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgRectangle240650891} />\n        </div>\n      </div>\n      <div className=\"absolute bg-[#e6e6e6] h-[480px] left-[560px] overflow-clip top-[150px] w-[800px]\" data-node-id=\"1:2353\">\n        <p className=\"[word-break:break-word] absolute font-['RussianRail_G_Pro:Regular'] leading-[normal] left-[28px] not-italic text-[#4b4b4b] text-[12px] top-[28px] tracking-[0.6px] uppercase whitespace-nowrap\" data-node-id=\"1:2354\">\n          / Приз за знания\n        </p>\n        <div className=\"-translate-y-1/2 [word-break:break-word] absolute content-stretch flex flex-col gap-[8px] items-start left-[28px] not-italic text-[#4353b0] top-1/2 w-[336px]\" data-node-id=\"1:2355\">\n          <p className=\"font-['RussianRail_G_Pro:Medium'] leading-[0] relative shrink-0 text-[48px] uppercase w-full\" data-node-id=\"1:2356\">\n            <span className=\"leading-[52px] text-[#4a66ca]\">500 рублей на</span>\n            <span className=\"leading-[52px]\">{` ozon.ru`}</span>\n          </p>\n          <p className=\"font-['FSRAILWAY_Book:Regular'] leading-[24px] relative shrink-0 text-[16px] w-full\" data-node-id=\"1:2357\">\n            Промокоды получат первые 300 участников, которые наберут 100+ баллов\n          </p>\n        </div>\n        <div className=\"absolute left-[744px] size-[56px] top-[424px]\" data-node-id=\"1:2358\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgRectangle240650891} />\n        </div>\n        <div className=\"absolute inset-[44.17%_3.51%_5.83%_62.13%]\" data-node-id=\"1:2359\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgGroup2087328480} />\n        </div>\n      </div>\n      <div className=\"absolute content-stretch flex flex-col gap-[24px] items-start left-[80px] top-[80px] w-[372px]\" data-node-id=\"1:2407\">\n        <div className=\"[word-break:break-word] content-stretch flex flex-col font-['RussianRail_G_Pro:Medium'] gap-[16px] items-start not-italic relative shrink-0 text-black uppercase w-full\" data-node-id=\"1:2408\">\n          <p className=\"leading-[normal] relative shrink-0 text-[12px] tracking-[0.6px] w-full\" data-node-id=\"1:2409\">\n            что можно получить\n          </p>\n          <p className=\"leading-[0] relative shrink-0 text-[0px] w-full whitespace-pre-wrap\" data-node-id=\"1:2410\">\n            <span className=\"leading-[40px] text-[36px]\">\n              {`чем больше играете — `}\n              <br aria-hidden />\n            </span>\n            <span className=\"leading-[40px] text-[#e21a1a] text-[36px]\">тем больше призов</span>\n          </p>\n        </div>\n        <p className=\"[word-break:break-word] font-['FSRAILWAY_Book:Regular'] leading-[24px] not-italic relative shrink-0 text-[#4b4b4b] text-[16px] w-full\" data-node-id=\"1:2411\">\n          Не знаете ответа? Доверьтесь интуиции и играйте!\n        </p>\n        <div className=\"content-stretch flex flex-col gap-[8px] items-start relative shrink-0 w-full\" data-node-id=\"1:2412\">\n          <div className=\"content-stretch flex gap-[12px] items-start relative shrink-0 w-full\" data-node-id=\"1:2413\">\n            <DoneRound className=\"relative shrink-0 size-[24px]\" />\n            <p className=\"[word-break:break-word] flex-[1_0_0] font-['FSRAILWAY_Book:Regular'] leading-[24px] min-w-px not-italic relative text-[#4b4b4b] text-[16px]\" data-node-id=\"1:2415\">\n              В первые 10 секунд правильный ответ принесет 1000 баллов. Чем быстрее ответите, тем больше баллов получите!\n            </p>\n          </div>\n          <div className=\"content-stretch flex gap-[12px] items-start relative shrink-0 w-full\" data-node-id=\"1:2416\">\n            <DoneRound className=\"relative shrink-0 size-[24px]\" />\n            <p className=\"[word-break:break-word] flex-[1_0_0] font-['FSRAILWAY_Book:Regular'] leading-[24px] min-w-px not-italic relative text-[#4b4b4b] text-[16px]\" data-node-id=\"1:2418\">\n              10 секунд вышло? Можно ответить и после, но за правильный ответ получите только 500 баллов\n            </p>\n          </div>\n          <div className=\"content-stretch flex gap-[12px] items-start relative shrink-0 w-full\" data-node-id=\"1:2419\">\n            <DoneRound className=\"relative shrink-0 size-[24px]\" />\n            <p className=\"[word-break:break-word] flex-[1_0_0] font-['FSRAILWAY_Book:Regular'] leading-[24px] min-w-px not-italic relative text-[#4b4b4b] text-[16px]\" data-node-id=\"1:2421\">\n              Неправильный ответ — всегда 0 баллов\n            </p>\n          </div>\n        </div>\n      </div>\n      <div className=\"absolute bg-[#4353b0] h-[480px] left-[560px] overflow-clip top-[220px] w-[800px]\" data-node-id=\"1:2422\">\n        <div className=\"absolute h-[480px] left-0 top-0 w-[800px]\" data-node-id=\"1:2423\" data-name=\"image 634450437\">\n          <div aria-hidden className=\"absolute inset-0 pointer-events-none\">\n            <div className=\"absolute inset-0 overflow-hidden\">\n              <img alt=\"\" className=\"absolute h-[151.77%] left-[6.19%] max-w-none top-[-25.84%] w-[151.84%]\" src={imgImage634450437} />\n            </div>\n            <div className=\"absolute bg-[#e21a1a] inset-0 mix-blend-color\" />\n            <div className=\"absolute inset-0\" style={{ backgroundImage: \"linear-gradient(89.99999999999999deg, rgb(226, 26, 26) 23.542%, rgba(226, 26, 26, 0) 71.89%), linear-gradient(180deg, rgb(226, 26, 26) 0%, rgba(228, 132, 49, 0.16) 60.735%)\" }} />\n          </div>\n        </div>\n        <p className=\"[word-break:break-word] absolute font-['RussianRail_G_Pro:Regular'] leading-[normal] left-[28px] not-italic text-[12px] text-white top-[28px] tracking-[0.6px] uppercase whitespace-nowrap\" data-node-id=\"1:2424\">\n          / Главный приз\n        </p>\n        <div className=\"-translate-y-1/2 [word-break:break-word] absolute content-stretch flex flex-col gap-[8px] items-start left-[28px] not-italic text-white top-1/2\" data-node-id=\"1:2425\">\n          <p className=\"font-['RussianRail_G_Pro:Medium'] leading-[52px] relative shrink-0 text-[48px] uppercase w-[432px]\" data-node-id=\"1:2426\">\n            3 сертификаТА на 50 000 рублей\n          </p>\n          <p className=\"font-['FSRAILWAY_Book:Regular'] leading-[24px] min-w-full relative shrink-0 text-[16px] w-[min-content]\" data-node-id=\"1:2427\">\n            Три участника с максимальным количеством баллов получат по сертификату на путешествие\n          </p>\n        </div>\n        <div className=\"absolute left-[744px] size-[56px] top-[424px]\" data-node-id=\"1:2428\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgRectangle240650891} />\n        </div>\n      </div>\n      <div className=\"absolute content-stretch flex items-center left-[80px] top-[644px]\" data-node-id=\"1:2429\" data-name=\"Button\">\n        <div className=\"flex flex-row items-center self-stretch\" data-node-id=\"1:2430\">\n          <div className=\"bg-[#e21a1a] h-full relative shrink-0 w-[14px]\" />\n        </div>\n        <div className=\"bg-[#e21a1a] content-stretch flex items-center justify-center overflow-clip pb-[10px] pt-[14px] px-[8px] relative shrink-0\" data-node-id=\"1:2431\" data-name=\"Button\">\n          <p className=\"[word-break:break-word] font-['RussianRail_G_Pro:Medium'] leading-[32px] not-italic relative shrink-0 text-[24px] text-white tracking-[-0.1px] uppercase whitespace-nowrap\" data-node-id=\"1:2432\" style={{ fontFeatureSettings: '\"lnum\" 1, \"pnum\" 1' }}>\n            Играть сейчас\n          </p>\n        </div>\n        <div className=\"flex flex-row items-center self-stretch\" data-node-id=\"1:2433\">\n          <div className=\"h-full relative shrink-0 w-[14px]\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgVector4556} />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
